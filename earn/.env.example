# ZeroDev project id (UUID) from https://dashboard.zerodev.app — sent on every ZeroDev Earn request
ZERODEV_PROJECT_ID=
# Any test private key. It funds the deposits, so keep amounts small.
PRIVATE_KEY=
# Only needed by deposit-with-kernel.ts (bundler + paymaster). Must be a Base project RPC.
ZERODEV_RPC=
